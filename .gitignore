.DS_Store
*.plasmoid
*.zip
build/
dist/
# Historical work artifacts belong in dist/review/ or the OS temp directory.
/docs/review/
/docs/reviews/
/docs/settings/
/docs/superpowers/
.cache/
# scripts/lib/qml_surfaces.py is imported by the static checks, so Python writes
# bytecode next to it.
__pycache__/
*.pyc
# Compiled from po/*.po by make package; included in the .plasmoid archive.
contents/locale/
# Crash dumps the kernel writes beside the tests when qmltestrunner or the
# smoke scripts abort. They embed process memory, so they must never be added.
core.[0-9]*
